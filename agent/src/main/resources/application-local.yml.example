# 本地开发配置模板。
# 复制为 agent/src/main/resources/application-local.yml 后填写真实值；
# 该文件已被 .gitignore 忽略。
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/aiops_agent?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: "你的MySQL密码"

deepseek:
  api-key: "sk-你的DeepSeek Key"
