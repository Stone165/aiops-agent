# 环境变量示例。本文件仅作文档，不会自动加载。
# 本地开发推荐直接编辑 agent/src/main/resources/application-local.yml（gitignored）。
# 只用环境变量时，设置 SPRING_PROFILES_ACTIVE=prod 再使用下面的变量。

# --- 后端 ---
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://localhost:3306/aiops_agent?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change-me
DB_CHECK_ON_STARTUP=true

# --- 本机监控 ---
MONITOR_NETWORK_HOST=www.baidu.com
MONITOR_NETWORK_PORT=443
MONITOR_NETWORK_TIMEOUT_MS=1000
MONITOR_SERVICE_NAME=MySQL
MONITOR_SERVICE_HOST=127.0.0.1
MONITOR_SERVICE_PORT=3306
MONITOR_SERVICE_TIMEOUT_MS=500

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_CONNECT_TIMEOUT=5s
DEEPSEEK_READ_TIMEOUT=60s
DEEPSEEK_MAX_TOOL_ROUNDS=5

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVER_PORT=8080

# --- 前端（复制 frontend/.env.example 为 frontend/.env）---
VITE_API_BASE_URL=/api
